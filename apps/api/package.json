{
  "name": "@site/api",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "test": "vitest",
    "typecheck": "tsc --noEmit",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "db:seed:local": "powershell -NoProfile -ExecutionPolicy Bypass -File ../../scripts/seed-local.ps1",
    "db:seed:remote": "wrangler d1 execute DB --remote --command=\"SELECT 'Remote seeding runs through the seed Worker; see Task 13.'\""
  },
  "dependencies": {
    "@site/contracts": "*",
    "hono": "^4.6.14",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.8.0",
    "@cloudflare/workers-types": "^4.0.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4",
    "wrangler": "^4.0.0"
  }
}
